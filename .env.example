# Set these in the hosting dashboard (Vercel > Project > Settings > Environment Variables). Never commit real values.

# DEFAULT: with none of the settings below, ordering stays on the restaurant's existing ordering page
# (https://order.yourmenu.com/villagegrille). Their POS tickets and flow are untouched. Nothing here is required.
#
# Everything below only switches on if ORDER_MODE is set on purpose, so adding a key alone changes nothing.
ORDER_MODE=                   # leave empty (default). "square" or "email" turns on the site's own checkout

# --- Optional own checkout: Square (card payment + ticket in the restaurant's Square POS) --- (card payment + ticket in the restaurant's Square POS) ---
SQUARE_ENV=sandbox            # "sandbox" for testing, "production" when live
SQUARE_APPLICATION_ID=        # Square Developer Console > your app > Credentials
SQUARE_ACCESS_TOKEN=          # same page (sandbox token for testing; the restaurant's production token when live)
SQUARE_LOCATION_ID=           # Developer Console > Locations (must match the app/token environment)

# --- Optional own checkout: Resend (order copy to the restaurant + receipt to the customer) ---
RESEND_API_KEY=
ORDER_EMAIL_TO=               # where orders go (comma-separated for several addresses)
ORDER_EMAIL_FROM=             # sender on a domain verified in Resend, e.g. "Village Grille <orders@yourdomain.com>"

# --- Optional ---
ENABLE_DELIVERY=false         # "true" shows a Delivery option; see SETUP.md (delivery tickets are limited in Square)
ANTHROPIC_API_KEY=            # AI chat assistant (built-in answers are used without it)
CHAT_MODEL=                   # defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper
