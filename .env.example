# Set these in the hosting dashboard (Vercel > Project > Settings > Environment Variables). Never commit real values.
# Changes only apply after a redeploy.

# DEFAULT (nothing below is required): the site runs its own cart and checkout as a DEMO. No payment, nothing sent to any POS;
# the customer gets a confirmation email if the Resend settings below are set.

# ---- The site's own checkout: card payment + the order lands in the restaurant's Square POS ----
ORDER_MODE=                   # leave empty for the demo. "square" = real checkout into Square (needs all Square values below)
SQUARE_ENV=sandbox            # "sandbox" while testing, "production" when live
SQUARE_APPLICATION_ID=        # Square Developer Console > your app > Credentials
SQUARE_ACCESS_TOKEN=          # same page. Sandbox token for testing; the restaurant's production token when live
SQUARE_LOCATION_ID=           # Developer Console > Locations

# ---- Customer receipt emails (Resend). Customers only; the restaurant is never emailed ----
RESEND_API_KEY=
ORDER_EMAIL_FROM=             # e.g. "Village Grille <orders@yourdomain.com>", a domain verified in Resend
ORDER_EMAIL_REPLY_TO=         # optional: where customer replies go (e.g. the restaurant's address)
SITE_URL=                     # your live site address, e.g. https://villagegrille.com (used for the logo in emails)

# ---- Optional ----
ENABLE_DELIVERY=false         # Square checkout is pickup-only unless "true" (delivery tickets are limited in Square, see SETUP.md)
ANTHROPIC_API_KEY=            # AI chat assistant (built-in answers are used without it)
CHAT_MODEL=                   # defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper
