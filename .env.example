# Set these in the hosting dashboard (e.g. Vercel > Project > Settings > Environment Variables).
# Never commit real values.

# AI chat assistant (api/chat.ts). Without it the chat still works using built-in answers.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5. claude-haiku-5-5 is much cheaper for a simple FAQ bot.
CHAT_MODEL=

# Online orders (api/order.ts) are emailed to the restaurant through Resend (resend.com).
# Without these, checkout tells the customer to call instead of pretending the order went through.
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Optional: sender on a domain verified in Resend (default only delivers to your own Resend account email)
ORDER_EMAIL_FROM=
